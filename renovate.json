{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base"
  ],
  "rebaseWhen": "conflicted",
  "timezone": "UTC",
  "schedule": [
    "at any time"
  ],
  "prConcurrentLimit": 5,
  "ignoreDeps": [
    "com.google.dagger:hilt-android",
    "com.google.dagger:hilt-android-compiler",
    "com.google.dagger:hilt-android-testing",
    "com.google.devtools.ksp",
    "org.jetbrains.kotlin.android",
    "org.jetbrains.kotlin.plugin.compose",
    "org.jetbrains.kotlin.plugin.serialization",
    "com.github.chuckerteam.chucker:library",
    "com.github.chuckerteam.chucker:library-no-op",
    "androidx.test.ext:junit",
    "androidx.test:runner",
    "com.google.dagger.hilt.android",
    "org.jetbrains.kotlinx:kotlinx-serialization-json",
    "org.jetbrains.kotlinx:kotlinx-serialization-core"
  ],
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackagePatterns": [
        "^androidx\\.compose",
        "^androidx\\.navigation",
        "^androidx\\.lifecycle",
        "^com\\.valentinilk\\.shimmer:compose-shimmer",
        "^io\\.coil-kt:coil-compose"
      ],
      "groupName": "Compose and UI",
      "groupSlug": "compose-ui"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackagePatterns": [
        "^androidx\\.room",
        "^androidx\\.work",
        "^androidx\\.datastore",
        "^androidx\\.core",
        "^androidx\\.appcompat",
        "^androidx\\.browser",
        "^androidx\\.preference",
        "^androidx\\.paging"
      ],
      "groupName": "AndroidX Core and Storage",
      "groupSlug": "androidx-core-storage"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackagePatterns": [
        "^com\\.squareup\\.okhttp3",
        "^com\\.squareup\\.retrofit2",
        "^com\\.squareup\\.moshi",
        "^org\\.jetbrains\\.kotlinx:kotlinx-coroutines"
      ],
      "groupName": "Networking and Coroutines",
      "groupSlug": "networking-coroutines"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackagePatterns": [
        "^androidx\\.benchmark",
        "^androidx\\.baselineprofile",
        "^androidx\\.profileinstaller"
      ],
      "groupName": "Android Performance and Benchmarks",
      "groupSlug": "android-benchmarks"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "matchPackagePatterns": [
        "^org\\.mockito",
        "^org\\.robolectric",
        "^app\\.cash\\.turbine",
        "^androidx\\.arch\\.core",
        "^androidx\\.test\\.uiautomator"
      ],
      "groupName": "Testing Libraries",
      "groupSlug": "testing-libs"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "groupName": null,
      "prPriority": -1
    }
  ]
}